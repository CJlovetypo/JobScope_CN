# Only distributable roots belong in this repository.
/*
!/.gitattributes
!/.gitignore
!/README.md
!/campus-job-fit/
!/internship-job-fit/
!/social-job-fit/
!/job-radar/
!/shared/
!/datasets/
!/recruitment-link-repair/
!/job-search/
!/docs/
/docs/*
!/docs/用户提示词模拟100例.md
!/docs/求职元能力架构迭代PRD.md
!/docs/元能力架构迭代测试报告.md
!/docs/匹配判断模型迭代审核稿.md
!/docs/匹配判断模型v5迭代PRD.md
!/docs/匹配判断模型v5测试报告.md
/datasets/recruitment-links/collections/
/datasets/recruitment-links/snapshots/
/datasets/recruitment-links/index/
/datasets/recruitment-links/manifests/
/shared/*
!/shared/job-search-core/

# Internal instructions, product planning and historical research remain local.
**/AGENTS.md
**/agents.md
**/PRD.md
**/ARCHITECTURE.md
**/internal/
/*/data/registry-inheritance.json
/shared/job-search-core/references/implementation-validation-*.md
/shared/job-search-core/data/feishu-expansion-*.json
/shared/job-search-core/data/source-verification-*.json

# Personal materials, captured data, reports and development evidence.
**/runs/
**/outputs/
/job-radar/state/
**/artifacts/
**/tmp/
**/logs/
**/tmp-*/
/shared/job-search-core/state/
*.repair.lock

# Dependencies, caches and local credentials.
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
coverage/
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
credentials.json
cookies.txt
cookies.json

# Editor and temporary files.
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.log
*.tmp
*.swp
~$*
