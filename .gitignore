# Only distributable roots belong in this repository.
/*
!/.gitattributes
!/.gitignore
!/README.md
!/campus-job-fit/
!/internship-job-fit/
!/social-job-fit/
!/shared/
/shared/*
!/shared/job-search-core/

# Internal instructions, product planning and historical research remain local.
**/AGENTS.md
**/agents.md
**/PRD.md
**/ARCHITECTURE.md
**/internal/
/*/data/registry-inheritance.json
/shared/job-search-core/references/implementation-validation-*.md
/shared/job-search-core/data/feishu-expansion-*.json
/shared/job-search-core/data/source-verification-*.json

# Personal materials, captured data, reports and development evidence.
**/runs/
**/outputs/
**/artifacts/
**/tmp/
**/logs/
**/tmp-*/
/shared/job-search-core/state/
*.repair.lock

# Dependencies, caches and local credentials.
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
coverage/
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
credentials.json
cookies.txt
cookies.json

# Editor and temporary files.
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.log
*.tmp
*.swp
~$*
